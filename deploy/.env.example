# Шаблон /srv/projects/donseller/.env (на сервере: владелец root, права 600).
# Как заполнить — DEPLOY.md, «Первый запуск», шаг 4: строки базы копируются
# из файла сервера, этот шаблон дописывается целиком, SECRET_KEY генерирует
# команда, остальное проверяется через sudoedit.
#
# Формат: ИМЯ=значение — без кавычек, без символа $ и без пробелов вокруг =.
# Комментарии — только на отдельных строках.

# --- База данных ---------------------------------------------------------
# Эти строки уже в .env: их копирует команда из DEPLOY.md из файла,
# который выдал сервер. Здесь они только для справки, поэтому
# закомментированы. Приложение читает DATABASE_URL.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=donseller
# POSTGRES_USER=donseller
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://donseller:<пароль>@postgres:5432/donseller

# --- Образ приложения ----------------------------------------------------
# Тег образа. При сборке его подставляет команда sed из DEPLOY.md,
# при откате — вписать прежний. Пустым не оставлять: compose не запустится.
DONSELLER_IMAGE=

# --- Приложение ----------------------------------------------------------
# Документация API (/docs, /redoc, /openapi.json). На сервере выключена.
ENABLE_DOCS=false
# JSON-список других сайтов, которым разрешены запросы к API с cookie.
# Сайт и API на одном домене — оставить []. Никогда не ["*"]: в коде включены
# cookie (allow_credentials), и тогда любой сайт сможет действовать
# от имени вошедшего пользователя.
CORS_ALLOWED_ORIGINS=[]
# Адрес сайта, без / на конце
FRONTEND_URL=https://donseller.mywayis.com

# --- Вход на сайт: JWT и cookie ------------------------------------------
# Ключ подписи токенов. Заполняет команда из DEPLOY.md (openssl rand -hex 32).
# Пустым не оставлять: с пустым ключом подделать вход сможет кто угодно.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_LEEWAY_SECONDS=60
EMAIL_TOKEN_TTL_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
# Домен cookie входа. Не указывать родительский mywayis.com:
# такие cookie получат и другие проекты на его поддоменах.
COOKIE_DOMAIN=donseller.mywayis.com
SECURE_COOKIES=true
# lax, strict или none
SAMESITE_COOKIES=lax

# --- Почта (SMTP) --------------------------------------------------------
# Код почту пока не отправляет, но без этих строк приложение не запустится.
# Пустые значения допустимы; SMTP_PORT и SMTP_USE_TLS должны быть заполнены.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Очередь задач (RabbitMQ) --------------------------------------------
# Код пока не использует, но строка обязательна. Пустое значение допустимо.
RABBITMQ_URL=

# --- Telegram-бот: на будущее, код их пока не читает ---------------------
# Токен бота Donseller от @BotFather (это не бот уведомлений сервера)
BOT_TOKEN=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token: openssl rand -hex 32
WEBHOOK_SECRET=
# Адрес сайта без / на конце; из него будет строиться адрес webhook
PUBLIC_BASE_URL=https://donseller.mywayis.com
